<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Đăng ký</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <div class="logo">
    <a href="/">COFFEE SHOP</a>
</div>

    <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Hạt cà phê</a>
    <a href="#">Thương hiệu</a>
    <a href="/blog">Câu chuyện</a>
    <a href="/contact">Liên hệ</a>

    <% if (user) { %>

        <span class="user-name">
            👤 <%= user.name %>
        </span>

        <a href="/logout">
            Đăng xuất
        </a>

    <% } else { %>

        <a href="/register">
            Đăng ký
        </a>

        <a href="/login">
            Đăng nhập
        </a>

    <% } %>

    <a href="/cart">
        🛒 Giỏ hàng
    </a>
</nav>
</header>


<section class="auth-page">

    <div class="auth-box">

        <p class="auth-label">
            COFFEE SHOP
        </p>

        <h1>ĐĂNG KÝ</h1>


        <% if (error) { %>

            <div class="auth-error">
                <%= error %>
            </div>

        <% } %>


        <form action="/register" method="POST">

            <label>Họ và tên</label>

            <input
                type="text"
                name="name"
                placeholder="Nguyễn Văn A"
                required
            >


            <label>Email</label>

            <input
                type="email"
                name="email"
                placeholder="example@gmail.com"
                required
            >


            <label>Mật khẩu</label>

            <input
                type="password"
                name="password"
                placeholder="Nhập mật khẩu"
                required
            >


            <label>Nhập lại mật khẩu</label>

            <input
                type="password"
                name="confirmPassword"
                placeholder="Nhập lại mật khẩu"
                required
            >


            <button type="submit">
                TẠO TÀI KHOẢN
            </button>

        </form>


        <p class="auth-switch">

            Đã có tài khoản?

            <a href="/login">
                Đăng nhập
            </a>

        </p>

    </div>

</section>

</body>

</html>