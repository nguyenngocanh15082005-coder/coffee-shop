<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= product.name %></title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <div class="logo">
    <a href="/">COFFEE SHOP</a>
</div>

    <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Hạt cà phê</a>
    <a href="#">Thương hiệu</a>
    <a href="/blog">Câu chuyện</a>
    <a href="/contact">Liên hệ</a>

    <% if (user) { %>

        <span class="user-name">
            👤 <%= user.name %>
        </span>

        <a href="/logout">
            Đăng xuất
        </a>

    <% } else { %>

        <a href="/register">
            Đăng ký
        </a>

        <a href="/login">
            Đăng nhập
        </a>

    <% } %>

    <a href="/cart">
        🛒 Giỏ hàng
    </a>
</nav>
</header>


<section class="product-detail">

    <div class="detail-image">

        <img
            src="<%= product.image %>"
            alt="<%= product.name %>"
        >

    </div>


    <div class="detail-info">

        <p class="detail-label">
            HẠT CÀ PHÊ
        </p>

        <h1>
            <%= product.name %>
        </h1>

        <p class="detail-price">
            <%= product.price.toLocaleString("vi-VN") %>đ
        </p>

        <hr>

        <p>
            <strong>Độ rang:</strong>
            <%= product.roast %>
        </p>

        <p>
            <strong>Khối lượng:</strong>
            <%= product.weight %>
        </p>

        <p class="detail-description">
            <%= product.description %>
        </p>


        <form
            action="/cart/add/<%= product.id %>"
            method="POST"
        >

            <button
                type="submit"
                class="add-cart-btn"
            >
                THÊM VÀO GIỎ HÀNG
            </button>

        </form>

    </div>

</section>

</body>
</html>